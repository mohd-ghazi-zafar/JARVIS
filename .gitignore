# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio IDE files
*.iml
.idea/
# Note: If your team shares code styles or run configs, ignore only specific files instead:
# .idea/workspace.xml
# .idea/tasks.xml
# .idea/caches
# .idea/libraries

# Keystore & Signing files (CRITICAL for security)
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (optional - ignore if keeping Firebase API keys private)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/reports/
lint/tmp/
lint/outputs/

# Android Profiling
*.hprof

# OS-specific files
.DS_Store
Thumbs.db

# Python & Brain artifacts
__pycache__/
*.py[cod]
*$py.class
brain/venv/
*.db
*.sqlite3
brain/models/*.gguf
